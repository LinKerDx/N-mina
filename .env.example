# ---------------------------------------------------------------------------
# Nómina360 — variables de entorno para docker compose / desarrollo local.
# Copia este archivo como .env y ajusta los valores. NUNCA comitees .env.
# ---------------------------------------------------------------------------

# --- Seguridad -------------------------------------------------------------
# HS256 requiere >= 32 bytes. En producción usa un secreto de 64+ bytes
# generado con: openssl rand -base64 64
JWT_SECRET=cambia-este-secreto-de-desarrollo-de-al-menos-32-bytes-0123456789
JWT_ISSUER=nomina360
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Bases de datos por área (una instancia por área) ----------------------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=nomina_auth
AUTH_DB_PASSWORD=auth_dev_pass

RH_DB_NAME=rh_db
RH_DB_USER=nomina_rh
RH_DB_PASSWORD=rh_dev_pass

PRODUCCION_DB_NAME=produccion_db
PRODUCCION_DB_USER=nomina_produccion
PRODUCCION_DB_PASSWORD=produccion_dev_pass

ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=nomina_admin
ADMIN_DB_PASSWORD=admin_dev_pass

# --- Mensajería ------------------------------------------------------------
RABBITMQ_USER=nomina
RABBITMQ_PASSWORD=nomina_dev_pass

# --- Frontend --------------------------------------------------------------
# URL del API Gateway tal como la ve el navegador.
VITE_API_URL=http://localhost:8080

# --- Respaldos (ver docs/RESPALDOS.md) -------------------------------------
# Secreto de cifrado del repositorio de respaldos (age / GPG).
BACKUP_ENCRYPTION_PASSPHRASE=cambia-esta-frase-de-cifrado-de-respaldos
# Destino S3-compatible (AWS S3, MinIO, Backblaze B2, Wasabi...)
BACKUP_S3_BUCKET=nomina360-backups
BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Retención (ver política GFS en docs/RESPALDOS.md)
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_WEEKS=8
BACKUP_RETENTION_MONTHS=12
